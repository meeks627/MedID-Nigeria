{
  "buildCommand": "npm run build:full",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "medid-*.json",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
